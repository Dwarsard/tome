# OS
.DS_Store
Thumbs.db

# Éditeurs
*.swp
*~

# Canevas de maquettes : artefact volumineux, regénéré par la skill design
design/*-design.html

# Claude Code : les réglages PERSONNELS restent locaux ; .claude/settings.json et .claude/hooks/
# sont versionnés exprès (garde-fous partagés contre toute écriture en production)
.claude/settings.local.json
.claude/*.local.json

# Secrets et environnement : jamais dans l'historique
.env
.env.*
.dev.vars
.dev.vars.*
.wrangler/
Secrets/

# Clés et certificats Apple : jamais dans ce dépôt PUBLIC (app iPhone, voir appli/APPLI-IOS.md).
# Ils vivent dans les secrets de l'environnement GitHub « testflight » et dans le gestionnaire
# de mots de passe ; appli/.gitignore répète la même liste pour le dossier de l'app.
*.p8
*.p12
*.pem
*.cer
*.mobileprovision
*private_key*
AuthKey_*
