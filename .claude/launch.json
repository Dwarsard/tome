{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tome",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "-l",
        "8791",
        "."
      ],
      "port": 8791
    },
    {
      "name": "tome-social",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "wrangler",
        "dev",
        "--cwd",
        "../Tome-Social",
        "--port",
        "8787",
        "--local",
        "--local-upstream",
        "localhost:8787"
      ],
      "port": 8787
    }
  ]
}
